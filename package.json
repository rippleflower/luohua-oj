{
  "name": "oj3",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev:web": "pnpm --filter @oj/web dev",
    "dev:admin": "pnpm --filter @oj/admin-web dev",
    "build:web": "pnpm --filter @oj/web build",
    "build:admin": "pnpm --filter @oj/admin-web build",
    "lint:web": "pnpm --filter @oj/web lint",
    "test:web": "pnpm --filter @oj/web test",
    "test:admin": "pnpm --filter @oj/admin-web test",
    "test:go": "go test ./apps/api/... ./apps/judge-worker/...",
    "test": "pnpm test:web && pnpm test:admin && pnpm test:go"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "eslint": "^9.12.0",
    "prettier": "^3.3.0"
  }
}
